# Database
# On Railway, set this to the reference variable: ${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgresql://...
# TLS override. Leave unset for sensible defaults (no SSL on localhost and on
# Railway's *.railway.internal private network; verified/unverified TLS elsewhere).
#   DATABASE_SSL=disable  -> never use SSL
#   DATABASE_SSL=require  -> force SSL even on the Railway private network
DATABASE_SSL=
# Optional but recommended for public/external Postgres: PEM contents of your
# provider's CA bundle. When set, the DB connection verifies the server
# certificate (rejects MITM). When unset, it falls back to unverified TLS + warning.
DATABASE_CA_CERT=

# OpenAI
OPENAI_API_KEY=sk-...

# Resend (email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=digest@churnlens.com

# Encryption (32-byte hex string for AES-256-GCM encryption of API keys)
ENCRYPTION_KEY=your-64-char-hex-string-here
# Ciphertext format NEW secrets are written in. Unset/0 writes the unprefixed v0
# format that every deployed build can read; 1 writes the "v1." versioned format.
# Reading both is always supported. Leave this unset when deploying the build that
# introduces v1, and set it to 1 only once that build is the confirmed rollback
# target — an older build cannot read a v1 value and will 500 on every webhook for
# the affected org.
ENCRYPTION_WRITE_VERSION=

# ── Polar (ChurnLens's own billing) ──────────────────────────────────────────
# Unrelated to the per-org Stripe keys above: those are CUSTOMERS' keys, used to
# detect THEIR churn. These bill us. Optional — the app boots and delivers
# surveys without them; only /api/billing/* and the Polar webhook need them.
#
# 'sandbox' (default) and 'production' are separate worlds with their own
# products, customers and tokens. Leave test environments on sandbox.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Product ids from the Polar dashboard, per tier. They differ between sandbox
# and production, which is why they are env vars and not database rows.
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_GROWTH=

# Internal cron secret — gates /api/themes, /api/digest, and /api/purge (the
# daily retention purge / account-deletion job).
CRON_SECRET=your-random-secret

# App — public base URL (used for survey/login links and per-org Stripe webhooks).
# On Railway, set this to: https://${{ RAILWAY_PUBLIC_DOMAIN }}
NEXT_PUBLIC_APP_URL=https://app.churnlens.com
